generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id         String   @id @default(uuid())
  nome       String
  preco      Float
  quantidade Int      @default(0)
  pedidos    Pedido[]
}

model Pedido {
  id         String   @id @default(uuid())
  quantidade Int
  data       DateTime @default(now())
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
}